<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name=".SettingsApp"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_network_status"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <provider
            android:name=".CalendarCountdownProvider"
            android:authorities="${applicationId}.calendar"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE" />
        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="io.github.libxposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
